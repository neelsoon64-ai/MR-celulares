import { doc, getDoc, setDoc, increment, serverTimestamp } from "firebase/firestore";
// Asegurate de importar tu instancia 'db' desde tu archivo de configuración de Firebase (ej: './firebaseConfig')
// import { db } from "./firebaseConfig";

async function registrarVisitaDiaria() {
  try {
    // Obtenemos la fecha actual en formato YYYY-MM-DD
    const hoy = new Date().toISOString().split("T")[0];
    
    // Referencia corregida a 2 segmentos exactos ("/dailyVisits/YYYY-MM-DD")
    const visitaRef = doc(db, "dailyVisits", hoy);

    // Intentamos incrementar el contador o crearlo si no existe para el día de hoy
    await setDoc(
      visitaRef,
      {
        count: increment(1),
        lastUpdated: serverTimestamp()
      },
      { merge: true }
    );

    console.log("Visita registrada correctamente para el día:", hoy);
  } catch (error) {
    console.error("No se pudo registrar la visita:", error);
  }
}

// Ejecutar la función al cargar la página o componente principal
registrarVisitaDiaria();